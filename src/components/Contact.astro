---
---

<section id="contact" aria-labelledby="contact-heading" class="mt-6 scroll-mt-28">
  <div class="glass-panel relative overflow-hidden p-7 sm:p-10">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <!-- Left -->
      <div>
        <p class="eyebrow">Let's connect</p>
        <h2 id="contact-heading" class="section-title mt-2 text-2xl sm:text-[1.9rem]">
          Have a project in mind?<br />Let's Build Something.
        </h2>
        <p class="mt-3 max-w-[40ch] text-[0.88rem] leading-relaxed text-[#6B7280]">
          Tell me about your idea — I reply within 24 hours on working days.
        </p>

        <ul class="mt-7 space-y-4 text-[0.87rem] font-semibold">
          <li class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-2xl bg-white/80 ring-1 ring-black/5 text-[#6C5CE7]" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
            </span>
            <!-- TODO: replace with real email -->
            <a href="mailto:[FILL_EMAIL]" aria-label="Email Girish Lade">[FILL_EMAIL]</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-2xl bg-white/80 ring-1 ring-black/5 text-[#6C5CE7]" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>
            </span>
            <!-- TODO: replace with real phone -->
            <a href="tel:[FILL_PHONE]" aria-label="Call Girish Lade">[FILL_PHONE]</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="grid h-10 w-10 place-items-center rounded-2xl bg-white/80 ring-1 ring-black/5 text-[#6C5CE7]" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" /></svg>
            </span>
            <span>Maharashtra, India</span>
          </li>
        </ul>

        <div class="mt-7 flex items-center gap-2.5">
          <!-- TODO: replace [FILL_SOCIAL] hrefs with real profile URLs -->
          <a href="[FILL_SOCIAL]" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile (opens in new tab)" class="grid h-10 w-10 place-items-center rounded-full bg-white/80 ring-1 ring-black/5 transition hover:text-[#6C5CE7]">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.35 1.08 2.92.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2z" /></svg>
          </a>
          <a href="[FILL_SOCIAL]" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter) profile (opens in new tab)" class="grid h-10 w-10 place-items-center rounded-full bg-white/80 ring-1 ring-black/5 transition hover:text-[#6C5CE7]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.4L6.47 22H3.35l7.24-8.28L1.2 2h6.4l4.42 5.85L18.9 2zm-1.1 17.8h1.73L7.7 3.9H5.85l11.95 15.9z" /></svg>
          </a>
          <a href="[FILL_SOCIAL]" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile (opens in new tab)" class="grid h-10 w-10 place-items-center rounded-full bg-white/80 ring-1 ring-black/5 transition hover:text-[#6C5CE7]">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H9z" /></svg>
          </a>
        </div>
        <p class="mt-6 text-[0.72rem] text-[#9ca3af]">© 2026 Girish Lade · Maharashtra, India</p>
      </div>

      <!-- Right : form -->
      <div class="glass-card !rounded-[20px] p-5 sm:p-7">
        <form id="contact-form" novalidate aria-label="Contact form">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="cf-name" class="mb-1.5 block text-[0.75rem] font-bold text-[#374151]">Your Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required placeholder="Jane Doe" class="field" aria-describedby="cf-status" />
            </div>
            <div>
              <label for="cf-email" class="mb-1.5 block text-[0.75rem] font-bold text-[#374151]">Your Email</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" required placeholder="jane@company.com" class="field" />
            </div>
          </div>
          <div class="mt-4">
            <label for="cf-message" class="mb-1.5 block text-[0.75rem] font-bold text-[#374151]">Your Message</label>
            <textarea id="cf-message" name="message" rows="5" required placeholder="Tell me about your project, timeline, and goals…" class="field resize-y"></textarea>
          </div>
          <p id="cf-status" role="status" aria-live="polite" class="mt-3 hidden text-[0.8rem] font-semibold"></p>
          <button type="submit" class="btn-primary mt-5 w-full justify-center !bg-[#151515]">
            Send Message
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13" /><path d="M22 2 15 22l-4-9-9-4z" /></svg>
          </button>
          <p class="mt-3 text-center text-[0.72rem] text-[#9ca3af]">
            Client-side demo only — no backend.
            <a class="underline underline-offset-2 hover:text-[#6C5CE7]" href="mailto:hello@ladestack.in?subject=Project%20inquiry%20for%20Girish%20Lade">Prefer email?</a>
          </p>
        </form>
      </div>
    </div>

    <!-- decorative glass swirl (CSS-only, reference detail) -->
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-[conic-gradient(from_120deg,#c4b5fd,#ede9fe,#a78bfa,#f5f3ff,#c4b5fd)] opacity-60 blur-2xl"></div>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var status = document.getElementById('cf-status');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = document.getElementById('cf-name');
      var email = document.getElementById('cf-email');
      var message = document.getElementById('cf-message');
      var ok = true;
      [name, email, message].forEach(function (el) {
        if (!el) return;
        var valid = el.value.trim().length > 1;
        if (el.type === 'email') valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim());
        el.style.borderColor = valid ? '' : '#ef4444';
        if (!valid) ok = false;
      });
      if (!status) return;
      status.classList.remove('hidden');
      if (!ok) {
        status.textContent = 'Please fill in your name, a valid email, and a message.';
        status.style.color = '#dc2626';
        return;
      }
      status.textContent = 'Thanks ' + name.value.trim().split(' ')[0] + '! Your message is ready — I’ll get back within 24 hours. (Demo: nothing was sent.)';
      status.style.color = '#15803d';
      form.reset();
      setTimeout(function () { status.classList.add('hidden'); }, 7000);
    });
  })();
</script>
