---
/* TODO: replace with real testimonials — quotes below are generic dev-community placeholders about LadeStack. */
const testimonials = [
  {
    quote:
      'LadeStack is stupidly fast for a free toolkit. I merged PDFs, compressed assets, and shared the result link — all without signing up.',
    name: 'Aarav Mehta',
    role: 'Frontend Developer',
    initials: 'AM',
    tint: 'bg-[#ede9fe] text-[#6C5CE7]',
  },
  {
    quote:
      'Coder + Docs replaced three paid subscriptions for our college club. Live preview and share links just work, even on low-end devices.',
    name: 'Sneha Kulkarni',
    role: 'CS Student, Pune',
    initials: 'SK',
    tint: 'bg-[#e0f2fe] text-[#0284c7]',
  },
  {
    quote:
      'Notes turned my scattered PDFs into a study assistant. Ask questions, get cited answers — it feels like NotebookLM without the paywall.',
    name: 'Rohan Patil',
    role: 'Mechanical Engineer',
    initials: 'RP',
    tint: 'bg-[#dcfce7] text-[#15803d]',
  },
];
---

<section id="testimonials" aria-labelledby="testimonials-heading" class="mt-6 scroll-mt-28">
  <div class="glass-panel p-7 sm:p-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Testimonials</p>
        <h2 id="testimonials-heading" class="section-title mt-2 text-2xl sm:text-[1.9rem]">What People Say</h2>
      </div>
      <div class="hidden gap-2 sm:flex" aria-hidden="true">
        <span class="grid h-9 w-9 place-items-center rounded-full bg-white/80 ring-1 ring-black/5 text-[#6B7280]">‹</span>
        <span class="grid h-9 w-9 place-items-center rounded-full bg-white/80 ring-1 ring-black/5 text-[#6B7280]">›</span>
      </div>
    </div>

    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {testimonials.map((t) => (
        <li>
          {/* TODO: replace with real testimonial */}
          <figure class="glass-card flex h-full flex-col p-6">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="#c4b5fd" aria-hidden="true"><path d="M10 7H6a3 3 0 0 0-3 3v7h7v-7H6.5A1.5 1.5 0 0 1 8 8.5V8a1 1 0 0 1 2-1zm11 0h-4a3 3 0 0 0-3 3v7h7v-7h-3.5A1.5 1.5 0 0 1 19 8.5V8a1 1 0 0 1 2-1z" /></svg>
            <blockquote class="mt-3 flex-1 text-[0.85rem] leading-relaxed text-[#4b5563]">
              “{t.quote}”
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-black/5 pt-4">
              <span class={`grid h-10 w-10 shrink-0 place-items-center rounded-full text-[0.72rem] font-extrabold ${t.tint}`} aria-hidden="true">
                {t.initials}
              </span>
              <span>
                <span class="block text-[0.85rem] font-extrabold">{t.name}</span>
                <span class="block text-[0.72rem] font-medium text-[#6B7280]">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
