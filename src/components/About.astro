<section id="about" aria-labelledby="about-heading" class="mt-10 scroll-mt-28">
  <div class="glass-panel p-7 sm:p-10">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Left -->
      <div>
        <p class="eyebrow">About me</p>
        <h2 id="about-heading" class="section-title mt-2 text-2xl sm:text-[1.9rem]">
          Engineering Precision.<br />Software Craft.
        </h2>
        <dl class="mt-8 grid grid-cols-3 gap-6 border-t border-black/5 pt-6">
          <div>
            <dt class="order-2 mt-1 block text-[0.7rem] font-medium text-[#6B7280]">Developers</dt>
            <dd class="text-xl font-extrabold sm:text-2xl">8K+</dd>
          </div>
          <div>
            <dd class="text-xl font-extrabold sm:text-2xl">5</dd>
            <dt class="mt-1 block text-[0.7rem] font-medium text-[#6B7280]">AI Products</dt>
          </div>
          <div>
            <dd class="text-xl font-extrabold sm:text-2xl">100+</dd>
            <dt class="mt-1 block text-[0.7rem] font-medium text-[#6B7280]">Countries</dt>
          </div>
        </dl>
      </div>
      <!-- Right -->
      <div class="flex flex-col justify-center">
        <p class="max-w-[52ch] text-[0.9rem] leading-relaxed text-[#4b5563]">
          LadeStack unifies code editing, API testing, documentation, and automation
          into one powerful ecosystem — enterprise-grade, zero cost, built for every
          developer.
        </p>
        <p class="mt-3 max-w-[52ch] text-[0.9rem] leading-relaxed text-[#6B7280]">
          I'm Girish Lade — a mechanical engineer turned software engineer. I design
          and ship fast, accessible web products with an engineering eye for detail.
        </p>
        <div class="mt-6">
          <a href="#contact" class="btn-secondary !py-2.5 !px-5 text-[0.82rem]" aria-label="More about me — go to contact">
            More About Me
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
