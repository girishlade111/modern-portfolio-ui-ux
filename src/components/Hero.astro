---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-nobg.png';

// NOTE: hero-nobg.png ships with a baked black background (not truly transparent).
// It is presented here as a dark portrait card inside the light glass hero so the
// layout proportions match the reference exactly. If a true cutout is supplied
// later, drop `portrait-blend` handling and use object-fit: contain on lavender.
---

<section id="home" aria-labelledby="hero-heading" class="pt-8 sm:pt-12">
  <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-6">
    <!-- Left column -->
    <div class="px-2 sm:px-6 lg:py-10">
      <span class="pill-label">Hello, I'm</span>
      <h1 id="hero-heading" class="mt-4 text-[2.6rem] leading-[1.02] font-extrabold tracking-tight sm:text-6xl">
        Girish Lade
      </h1>
      <p class="gradient-text mt-2 text-[1.35rem] leading-snug font-extrabold tracking-tight sm:text-[1.7rem]">
        Mechanical Engineer → Software Engineer&nbsp;| Founder, LadeStack
      </p>
      <p class="mt-4 max-w-[46ch] text-[0.95rem] leading-relaxed text-[#6B7280]">
        Build smarter products with AI tools.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="#work" class="btn-primary" aria-label="View my work">
          View My Work
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7" /><path d="M8 7h9v9" /></svg>
        </a>
        <a
          href="https://www.ladestack.in/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary"
          aria-label="Visit LadeStack (opens in new tab)"
        >
          Visit LadeStack
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6" /><path d="M20 4 11 13" /><path d="M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6" /></svg>
        </a>
      </div>

      <!-- Trust row -->
      <div class="mt-9">
        <p class="text-[0.7rem] font-semibold tracking-wide text-[#9ca3af]">Building</p>
        <ul aria-label="LadeStack products" class="mt-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-[0.82rem] font-bold text-[#9aa0ae]">
          <li class="transition hover:text-[#6C5CE7]">LS&nbsp;PDF</li>
          <li class="transition hover:text-[#6C5CE7]">LadeStack&nbsp;Coder</li>
          <li class="transition hover:text-[#6C5CE7]">LadeDesign</li>
          <li class="transition hover:text-[#6C5CE7]">LS&nbsp;Docs</li>
          <li class="transition hover:text-[#6C5CE7]">LadeStack&nbsp;Notes</li>
        </ul>
      </div>
    </div>

    <!-- Right column : portrait glass frame -->
    <div class="relative mx-auto w-full max-w-[440px] lg:max-w-none">
      <!-- lavender glow blob behind -->
      <div aria-hidden="true" class="absolute -inset-6 -z-0 rounded-[40px] bg-[radial-gradient(60%_60%_at_60%_30%,rgba(167,139,250,0.5),transparent_70%),radial-gradient(50%_50%_at_30%_80%,rgba(108,92,231,0.25),transparent_70%)] blur-2xl"></div>

      <div class="glass relative z-10 overflow-hidden rounded-[32px] p-2.5">
        <div class="relative overflow-hidden rounded-[24px] bg-[#101014]">
          <Image
            src={heroImg}
            alt="Portrait of Girish Lade, founder of LadeStack"
            widths={[480, 720, 960]}
            sizes="(max-width: 1024px) 90vw, 520px"
            class="h-[420px] w-full object-cover object-[50%_18%] sm:h-[520px]"
            loading="eager"
            fetchpriority="high"
          />
          <!-- soft bottom fade so torso crop melts into frame like reference -->
          <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-[#101014]/70 to-transparent"></div>
          <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-[24px] ring-1 ring-inset ring-white/20"></div>
        </div>
      </div>

      <!-- Floating badge : top-right -->
      <div class="glass animate-floaty absolute -right-2 top-6 z-20 rounded-2xl px-4 py-3 text-center sm:-right-5">
        <p class="text-2xl font-extrabold leading-none">3+</p>
        <p class="mt-1 text-[0.65rem] font-semibold leading-tight text-[#6B7280]">Years<br />Building</p>
      </div>

      <!-- Floating badge : bottom-left overlapping image -->
      <div class="glass animate-floaty-delayed absolute -left-2 bottom-10 z-20 flex items-center gap-3 rounded-2xl px-4 py-3 sm:-left-6">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-[#ede9fe] text-[#6C5CE7]" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8" /><path d="M15 7h6v6" /></svg>
        </span>
        <span>
          <span class="block text-[0.65rem] font-semibold text-[#6B7280]">Community</span>
          <span class="block text-sm font-extrabold">8K+ Developers</span>
        </span>
      </div>

      <!-- small sparkle chip on left edge (reference detail) -->
      <div aria-hidden="true" class="glass absolute left-[-14px] top-1/2 z-20 hidden h-11 w-11 -translate-y-1/2 place-items-center rounded-full sm:grid">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#8b7cf6"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4L12 2z" /></svg>
      </div>
    </div>
  </div>
</section>
